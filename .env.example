# Скопируйте этот файл в .env и заполните своими значениями.

# --- Telegram ---
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=111111111

# --- ИИ (VedAI Console / AIAI.BY) ---
VEDAI_API_URL=https://vedai.by/api/v1/chat/completions
VEDAI_API_KEY=
VEDAI_MODEL=VedAI

# --- EmailJS ---
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_USER_ID=
# Опционально: personal API key из EmailJS (Dashboard -> Account -> API Keys)
EMAILJS_ACCESS_TOKEN=
NOTIFY_EMAIL=service@magnat.by

# --- База данных (не обязательно) ---
DB_FILENAME=magnat_service.db
